{
  "name": "@zebo-commerce/typescript-sdk",
  "version": "1-preview.0",
  "description": "Official TypeScript SDK for the Zebo Commerce API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zebo",
    "api",
    "commerce",
    "communications",
    "marketing",
    "payments",
    "sdk",
    "typescript",
    "mobile-money"
  ],
  "author": "Zebo Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zebodotdev/commerce-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/zebodotdev/commerce-sdk-typescript/issues"
  },
  "homepage": "https://github.com/zebodotdev/commerce-sdk-typescript#readme",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=24"
  }
}
